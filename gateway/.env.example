# --- Used by docker compose (network layout) ---
# Docker network that Open WebUI, Whisper and Piper are already attached to
# (`docker network ls`, `docker inspect <open-webui container>`).
DOCKER_NETWORK=
OWUI_URL=http://open-webui:8080
WHISPER_URI=tcp://wyoming-whisper:10300
PIPER_URI=tcp://wyoming-piper:10200

# Tailscale auth key (reusable, not ephemeral) for the "switchboard" node.
TS_AUTHKEY=

# --- Sign-in ---
# owui: people log in with their Open WebUI account (default). none: no login;
# the Gateway acts as the single account below, as before.
AUTH_MODE=owui
# Encrypts the login cookie so logins survive Gateway restarts. Generate once:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Read by the Gateway itself ---
# Only needed when AUTH_MODE=none.
SWITCHBOARD_OWUI_EMAIL=
SWITCHBOARD_OWUI_PASSWORD=

# --- Optional: Chatterbox TTS (docker compose --profile chatterbox up -d --build) ---
# TTS_BACKEND=chatterbox       # prefer Chatterbox; Piper is the automatic fallback
# VIDEO_GID=44                 # host GIDs for GPU access: getent group video render
# RENDER_GID=109
